<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!--Used only by the test notification tool in settings-->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!--Used only for downloading wallpapers-->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Parking button on home: saves the GPS position of the car -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--Used only for opening alarm app-->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- ToDo alerts: on time (notification or alarm), again after a reboot -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!--Used for Private Space support on Android 15+-->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <!--Calendar widget on home: reads the events of the phone's calendars-->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!--Home search: contacts and files on the phone-->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- To see which app opens PDFs (to offer to become it) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="UnusedAttribute">

        <!-- Built-in file explorer (phone and OneDrive), also listed as "File" in the app list -->
        <activity
            android:name=".ui.FileExplorerActivity"
            android:exported="false"
            android:label="@string/ml_explorer"
            android:launchMode="singleTask"
            android:taskAffinity="app.minimalauncher.files"
            android:windowSoftInputMode="adjustResize" />

        <!-- OneDrive sign-in: Microsoft redirects here (see OneDrive) -->
        <activity
            android:name=".ui.OneDriveAuthActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="auth"
                    android:scheme="minimalauncher" />
            </intent-filter>
        </activity>

        <!-- The explorer as a folder picker (folder shortcuts, swipe actions) -->
        <activity
            android:name=".ui.FolderPickerActivity"
            android:exported="false"
            android:label="@string/ml_explorer" />

        <!-- Built-in PDF viewer and editor; also offered to other apps opening a PDF -->
        <activity
            android:name=".ui.pdf.PdfViewerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/ml_pdf_tool"
            android:taskAffinity="app.minimalauncher.files"
            android:theme="@style/ViewerTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-pdf" />
                <data android:mimeType="application/acrobat" />
            </intent-filter>
            <!-- A PDF link from the browser or another app: downloaded, then opened -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
                <data android:pathPattern=".*\\..*\\.pdf" />
                <data android:pathPattern=".*\\..*\\..*\\.pdf" />
            </intent-filter>
            <!-- Explorers that only pass the file name (unknown or generic type) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
                <data android:pathPattern=".*\\..*\\.pdf" />
                <data android:pathPattern=".*\\..*\\..*\\.pdf" />
            </intent-filter>
            <!-- "Share" a PDF to the tool -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.pdf.PdfPagesActivity"
            android:exported="false"
            android:taskAffinity="app.minimalauncher.files"
            android:theme="@style/ViewerTheme" />
        <activity
            android:name=".ui.pdf.SignatureActivity"
            android:exported="false"
            android:taskAffinity="app.minimalauncher.files"
            android:theme="@style/ViewerTheme" />

        <!-- Document scanner (Google's scanner, then our review and PDF), also listed as "Scanner" in the app list -->
        <activity
            android:name=".ui.scanner.ScannerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/ml_scan_app"
            android:taskAffinity="app.minimalauncher.scanner"
            android:theme="@style/ViewerTheme" />

        <!-- Built-in photo/video viewer and editors -->
        <activity
            android:name=".ui.media.MediaViewerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:taskAffinity="app.minimalauncher.files"
            android:theme="@style/ViewerTheme" />
        <activity
            android:name=".ui.media.PhotoEditActivity"
            android:exported="false"
            android:taskAffinity="app.minimalauncher.files"
            android:theme="@style/ViewerTheme" />
        <activity
            android:name=".ui.media.VideoEditActivity"
            android:exported="false"
            android:taskAffinity="app.minimalauncher.files"
            android:theme="@style/ViewerTheme" />

        <!-- Album grid opened from the home search -->
        <activity
            android:name=".ui.AlbumActivity"
            android:exported="false"
            android:taskAffinity="app.minimalauncher.files" />

        <activity-alias
            android:name=".FilesAlias"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/ml_explorer"
            android:targetActivity=".ui.FileExplorerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ScannerAlias"
            android:exported="true"
            android:icon="@drawable/ic_scanner_launcher"
            android:label="@string/ml_scan_app"
            android:targetActivity=".ui.scanner.ScannerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Text recognition model for the PDF tool, downloaded with the app by Play services -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- ToDo app, also listed as "ToDo" in the app list -->
        <activity
            android:name=".ui.todo.TodoActivity"
            android:exported="false"
            android:label="@string/ml_todo_app"
            android:launchMode="singleTask"
            android:taskAffinity="app.minimalauncher.todo" />
        <activity
            android:name=".ui.todo.TodoEditActivity"
            android:exported="false"
            android:label="@string/ml_todo_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.todo.TodoAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.minimalauncher.todoalarm" />
        <!-- Share > Bookmarks from a browser: add the page to the launcher's bookmarks -->
        <activity
            android:name=".ui.bookmarks.BookmarkShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/ml_bm_share_label"
            android:taskAffinity="app.minimalauncher.bookmarks"
            android:theme="@style/ShareTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.weather.WeatherActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.minimalauncher.weather"
            android:theme="@style/ViewerTheme" />

        <activity-alias
            android:name=".TodoAlias"
            android:exported="true"
            android:icon="@drawable/ic_todo_launcher"
            android:label="@string/ml_todo_app"
            android:targetActivity=".ui.todo.TodoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".helper.TodoAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Shares phone files with the app that opens them -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".helper.PinItemActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".helper.FakeHomeActivity"
            android:enabled="false"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".listener.DeviceAdmin"
            android:exported="false"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".helper.NotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".helper.MyAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>

    </application>

</manifest>