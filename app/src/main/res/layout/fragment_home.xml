<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    tools:context=".ui.HomeFragment">

    <!-- Placeholder layout for locking screen-->
    <FrameLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/lock_layout_description" />

    <!-- Home button for recents feature disabled -->
    <!-- Placeholder layout for showing recent apps
    <FrameLayout
        android:id="@+id/recents"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/recents_layout_description" /> -->

    <LinearLayout
        android:id="@+id/homeColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Home: clock/date header, then the user's sections. Scrolls; gestures handled by HomeScrollView -->
        <app.olauncher.ui.HomeScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Clock on top, date / battery / screen time on its right -->
                <FrameLayout
                    android:id="@+id/headerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/dateTimeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="72dp"
                        android:layout_marginTop="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextClock
                            android:id="@+id/clock"
                            style="@style/TextDefault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:format12Hour="h:mm"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/time_size"
                            tools:text="02:34" />

                        <LinearLayout
                            android:id="@+id/dateColumn"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <!-- Date and week number, as large as fits next to the clock -->
                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/date"
                                style="@style/TextDefault"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:gravity="center_vertical|start"
                                android:maxLines="1"
                                android:paddingVertical="2dp"
                                app:autoSizeMaxTextSize="26sp"
                                app:autoSizeMinTextSize="14sp"
                                app:autoSizeTextType="uniform"
                                tools:text="ven 16 ott · W42" />


                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvScreenTime"
                                style="@style/TextSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:textSize="@dimen/date_size"
                                android:visibility="gone"
                                tools:text="2h 11m"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Detox: icon at the top right; remaining time while a session runs -->
                    <TextView
                        android:id="@+id/detoxBar"
                        style="@style/TextDefault"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="40dp"
                        android:layout_marginEnd="24dp"
                        android:contentDescription="Detox"
                        android:padding="6dp"
                        android:text="@string/ml_detox_start_label"
                        android:textSize="22sp" />
                </FrameLayout>

                <!-- Widgets, below the clock -->
                <app.olauncher.ui.widgets.WidgetGridLayout
                    android:id="@+id/widgetsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone" />



                <Space
                    android:id="@+id/bottomAlignSpace"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0" />

                <TextView
                    android:id="@+id/notificationAccessHint"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="24dp"
                    android:alpha="0.8"
                    android:paddingVertical="6dp"
                    android:text="@string/ml_notification_access_hint"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/noSectionsHint"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:alpha="0.6"
                    android:layout_marginTop="24dp"
                    android:text="@string/ml_home_no_sections_hint"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/sectionsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="96dp" />

            </LinearLayout>
        </app.olauncher.ui.HomeScrollView>

        <!-- Fixed bottom area: app icons and widgets on a grid -->
        <app.olauncher.ui.widgets.WidgetGridLayout
            android:id="@+id/bottomGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Search results (phone / OneDrive), in place of home while searching -->
        <ScrollView
            android:id="@+id/searchResultsScroll"
            android:fillViewport="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/searchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="40dp"
                android:paddingBottom="8dp" />
        </ScrollView>

        <!-- Search bar: Google, phone or OneDrive (selector on the right) -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/searchInput"
                style="@style/TextSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/ml_search_hint_web"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColorHint="?attr/primaryColorTrans50"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/searchClear"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="✕"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/searchMode"
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                tools:text="Google ▾" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/firstRunTips"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="56dp"
        android:text="@string/swipe_up_for_apps"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Set default launcher -->
    <TextView
        android:id="@+id/setDefaultLauncher"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="56dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/set_as_default_launcher_u"
        android:visibility="gone" />
</FrameLayout>