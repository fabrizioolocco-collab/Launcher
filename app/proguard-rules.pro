# PdfBox-Android: the JPEG 2000 codec is an optional dependency we don't ship
-dontwarn com.gemalto.jp2.**
# PdfBox loads fonts and resources by name
-keep class com.tom_roush.pdfbox.** { *; }
-dontwarn com.tom_roush.pdfbox.**
